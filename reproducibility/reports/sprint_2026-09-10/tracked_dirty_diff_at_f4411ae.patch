+def _canonical_lafan1_orientations(human_quat: torch.Tensor) -> torch.Tensor:
+    """Convert pair-local LAFAN1 body frames to the canonical local basis.
+
+    The GMR LAFAN1 loader has already applied the world-coordinate conversion to
+    both positions and orientations.  This remaining operation is a local-basis
+    relabelling, hence the Hamilton product is on the right and positions must not
+    be rotated again.
+    """
+
+    if not human_quat.is_floating_point() or not torch.isfinite(human_quat).all():
+        raise ValueError("human_quat must contain finite floating-point values")
+    input_norms = torch.linalg.vector_norm(human_quat, dim=-1)
+    if not torch.allclose(
+        input_norms,
+        torch.ones_like(input_norms),
+        rtol=0.0,
+        atol=_QUATERNION_NORM_ATOL,
+    ):
+        raise ValueError("human_quat must contain unit quaternions")
+
+    basis = human_quat.new_tensor(LAFAN1_PAIR_TO_CANONICAL_BASIS_WXYZ)
+    calibrated = rot.quat_mul(human_quat, basis)
+    output_norms = torch.linalg.vector_norm(calibrated, dim=-1, keepdim=True)
+    if not torch.isfinite(output_norms).all() or torch.any(
+        output_norms <= torch.finfo(calibrated.dtype).tiny
+    ):
+        raise ValueError("LAFAN1 source-basis calibration produced invalid quaternions")
+    return calibrated / output_norms
+
