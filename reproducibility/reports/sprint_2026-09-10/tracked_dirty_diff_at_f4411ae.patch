+def test_pair_adapter_right_multiplies_every_body_and_preserves_position_products(
+    tmp_path,
+):
+    arrays = _pair_arrays()
+    body_count = len(LAFAN1_BODY_NAMES)
+    angles = np.linspace(0.05, 0.45, body_count, dtype=np.float64)
+    axes = np.eye(3, dtype=np.float64)[np.arange(body_count) % 3]
+    body_quaternions = np.concatenate(
+        (
+            np.cos(0.5 * angles)[:, None],
+            axes * np.sin(0.5 * angles)[:, None],
+        ),
+        axis=-1,
+    )
+    arrays["human_quat"] = np.broadcast_to(
+        body_quaternions[None], arrays["human_quat"].shape
+    ).astype(np.float32, copy=True)
+    path, digest, _ = _write_pair(tmp_path, arrays=arrays)
+    adaptation = _adapt(path, digest)
+    spec = adaptation.motion_spec
+
+    selected = arrays["human_quat"][1:4]
+    basis = np.asarray(LAFAN1_PAIR_TO_CANONICAL_BASIS_WXYZ)
+    expected = _hamilton_product(selected, basis)
+    wrong_direction = _hamilton_product(basis, selected)
+    np.testing.assert_allclose(spec.body_orientations_wxyz[::2], expected, atol=1e-7)
+    assert np.max(np.abs(expected - wrong_direction)) > 0.1
+    assert np.isfinite(spec.body_orientations_wxyz).all()
+    np.testing.assert_allclose(
+        np.linalg.norm(spec.body_orientations_wxyz, axis=-1), 1.0, atol=1e-12
+    )
+
+    hips = LAFAN1_BODY_NAMES.index("Hips")
+    np.testing.assert_array_equal(
+        spec.root_orientation_wxyz, spec.body_orientations_wxyz[:, hips]
+    )
+    np.testing.assert_allclose(spec.body_positions[::2], arrays["human_pos"][1:4])
+    np.testing.assert_array_equal(spec.root_position, spec.body_positions[:, hips])
+
+    identity_arrays = _pair_arrays()
