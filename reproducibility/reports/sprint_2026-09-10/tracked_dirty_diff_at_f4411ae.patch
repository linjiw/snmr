+def _hamilton_product(left: np.ndarray, right: np.ndarray) -> np.ndarray:
+    """Independent NumPy wxyz product used to test multiplication direction."""
+
+    lw, lx, ly, lz = np.moveaxis(np.asarray(left), -1, 0)
+    rw, rx, ry, rz = np.moveaxis(np.asarray(right), -1, 0)
+    return np.stack(
+        (
+            lw * rw - lx * rx - ly * ry - lz * rz,
+            lw * rx + lx * rw + ly * rz - lz * ry,
+            lw * ry - lx * rz + ly * rw + lz * rx,
+            lw * rz + lx * ry - ly * rx + lz * rw,
+        ),
+        axis=-1,
+    )
+
