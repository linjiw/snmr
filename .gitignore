# Experiment artifacts: keep structured metrics and protocols in git; keep
# regenerable binaries, raw console output, and host-local pointers out.
runs/**/ckpt*.pt
runs/**/*.pt
runs/**/*.npz
runs/*.log
runs/**/*.log
runs/**/eval_backup/
runs/**/*_ckpt.txt
runs/**/TEACHER_DONE
exports/*.npz
/exports/e70_video/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
/.codex/
# scratch training logs at repo root (per-run logs live in runs/<name>/)
runs_*.log

